---
import { format } from "date-fns"

import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/utils"

const recentPosts = (await getPosts()).slice(0, 10)
---

<Layout title="musicmusic’s foobar2000 stuff">
  <p>
    On this site, you’ll find various components I’ve written for the{" "}
    <a href="https://foobar2000.org">foobar2000 audio player</a>.
  </p>
  <h2>Latest news</h2>
  <ol>
    {
      recentPosts.map((post) => (
        <li id={post.id}>
          <p class="post-date">
            <time datetime={post.data.date.toISOString()}>
              {format(post.data.date, "d MMMM yyyy")}
            </time>
          </p>
          <a href={`/news/${post.id}`}>{post.data.title}</a>
          <p>{post.data.excerpt}</p>
        </li>
      ))
    }
  </ol>
  <p>
    <a href={new URL("rss.xml", Astro.site)}>
      <i aria-hidden="true" class="fa-solid fa-rss"></i>&emsp13;RSS
    </a>
  </p>
</Layout>

<style>
  ol {
    list-style: none;
    padding: 0;
    margin-left: 0;
  }

  li {
    padding-left: 0;
    margin-bottom: 1.25rem;
    line-height: 1.5;

    a {
      font-size: 22px;
      font-weight: 600;

      &:not(:hover) {
        text-decoration-line: none;
      }
    }
  }

  .post-date {
    margin: 0;
  }
</style>
